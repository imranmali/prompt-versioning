# Copy to .env for local development. All variables use the PROMPTLAB_ prefix.
PROMPTLAB_ENVIRONMENT=development
PROMPTLAB_DATABASE_URL=sqlite+aiosqlite:///./promptlab.db
# PROMPTLAB_DATABASE_URL=postgresql+asyncpg://promptlab:promptlab@localhost:5432/promptlab
PROMPTLAB_BOOTSTRAP_ADMIN_KEY=change-me-dev-admin-key
PROMPTLAB_LOG_LEVEL=INFO
PROMPTLAB_LOG_JSON=false
PROMPTLAB_METRICS_ENABLED=true
PROMPTLAB_RESOLVE_CACHE_TTL_SECONDS=2
# PROMPTLAB_CORS_ORIGINS=http://localhost:3000
